{
  "tasks": {
    "dev": "deno run --watch --env-file --unstable-net --allow-net --allow-env --allow-read --allow-sys main.ts",
    "start": "deno run --env-file --unstable-net --allow-net --allow-env --allow-read --allow-sys main.ts",
    "resolve": "deno run --env-file --unstable-net --allow-net --allow-env --allow-read --allow-sys scripts/resolve.ts",
    "migrate": "deno run --env-file --allow-net --allow-env --allow-read --allow-sys scripts/migrate.ts",
    "test": "deno test --unstable-net --unstable-sloppy-imports --allow-net --allow-env --allow-read --allow-write --allow-sys",
    "check": "deno check --unstable-sloppy-imports main.ts src/**/*.ts test/**/*.ts scripts/*.ts devstack/*.ts",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "postgres": "npm:postgres@^3.4.9",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.5"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    ".git",
    "coverage",
    "tmp",
    "devstack/public/vendor"
  ]
}
