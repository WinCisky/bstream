# Copy to .env and fill in. Loaded by every deno task via --env-file.

# Postgres connection string. A Supabase URL and a plain Postgres URL differ only here.
#
#   Supabase, transaction pooler (:6543) — the usual choice, and IPv4:
#     postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   Supabase, direct (:5432) — full Postgres, but IPv6-only on newer projects:
#     postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   Anything else:
#     postgresql://user:password@host:5432/ma_stream
MA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ma_stream

# Named prepared statements. Off by default, which is the only setting that is correct on
# Supabase's transaction pooler — it hands each statement a different server connection, so a
# prepared statement is gone by the time it is used. Set to 1 on a direct or session-mode
# connection if you want them; the saving is invisible next to a swarm walk either way.
# MA_DB_PREPARE=0

# MA_DB_POOL_SIZE=5
# MA_DB_CONNECT_TIMEOUT_MS=10000
# 0 keeps connections open. Set ~30000 behind a pooler that charges per connection.
# MA_DB_IDLE_TIMEOUT_MS=0

# Shared secret for POST /refresh. Unset means the route refuses every request.
# MA_REFRESH_TOKEN=
